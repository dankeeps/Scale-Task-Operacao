# Variáveis do frontend (públicas — vão no bundle do navegador).
# Copie para `.env` (produção) ou `.env.local` (dev) e preencha com o SEU projeto.

# Produção: pegue em Supabase → Project Settings → API.
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key"

# Dev local com Supabase local (`supabase start` imprime estes valores):
#   VITE_SUPABASE_URL="http://127.0.0.1:54321"
#   VITE_SUPABASE_PUBLISHABLE_KEY="<anon key impressa pelo supabase start>"

# Web Push — chave PÚBLICA do par VAPID (gere com `npx web-push generate-vapid-keys`).
VITE_VAPID_PUBLIC_KEY="sua-vapid-public-key"
